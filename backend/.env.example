# Agent CrossDo — envio de e-mail transacional
# Não commitar .env real. Preencher na VPS/secret manager.

ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=
SESSION_EXPIRY_HOURS=12

# URL pública usada nos links dos e-mails
PORTAL_URL=https://agent.crossdo.app
CORS_ORIGINS=https://agent.crossdo.app
AGENT_CROSSDO_DATA_DIR=/var/lib/agent-crossdo

N8N_INGEST_TOKEN=

# Opção 1: Brevo API
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# Remetente precisa estar validado no provedor escolhido
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Agent CrossDo

# Opção 2: SMTP corporativo
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
